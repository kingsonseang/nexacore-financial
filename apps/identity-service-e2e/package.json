{
  "name": "@org/identity-service-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "implicitDependencies": ["@org/identity-service"],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": ["{projectRoot}/test-output/jest/coverage"],
        "options": {
          "jestConfig": "apps/identity-service-e2e/jest.config.cts",
          "passWithNoTests": true
        },
        "dependsOn": [
          "@org/identity-service:build",
          "@org/identity-service:serve"
        ]
      }
    }
  }
}
